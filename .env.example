# Environment mode: development | staging | production
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://openscript:openscript_secret@localhost:5432/openscript

# Security Secrets
SESSION_SECRET=replace_with_a_secure_random_string_of_minimum_32_characters

# Application Domains & CORS
CORS_ORIGIN=http://localhost:5173,https://dev-openscript.ssnpictures.in,https://openscript.ssnpictures.in
APP_URL=http://localhost:5173
APP_BASE_URL=https://dev-openscript.ssnpictures.in

# Persistent Data Storage Directories
EXPORT_TEMP_DIR=/tmp/openscript-exports
DATA_DIR=/var/lib/openscript

# Cloud Storage Configuration (Optional: AWS S3, Cloudflare R2, MinIO, or Wasabi)
# If omitted, OpenScript automatically uses persistent local volume storage (/var/lib/openscript/backups)
S3_BUCKET=openscript-studio-dev
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_PUBLIC_URL=https://assets.openscript.ssnpictures.in

# Transactional Email (Google SMTP or Standard SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_letter_app_password
EMAIL_FROM="OpenScript Studio <your_email@gmail.com>"
