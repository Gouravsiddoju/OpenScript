# ==============================================================================
# OpenScript Production (Deployed from 'release' branch)
# ==============================================================================
openscript.ssnpictures.in {
    encode gzip zstd

    # Fastify API reverse proxy
    handle /api/* {
        reverse_proxy api:3000
    }

    # Static web app reverse proxy
    handle {
        reverse_proxy web:80
    }
}

# ==============================================================================
# OpenScript Dev / Staging Preview (Deployed from 'dev' branch)
# ==============================================================================
dev.openscript.ssnpictures.in {
    encode gzip zstd

    # Dev API reverse proxy
    handle /api/* {
        reverse_proxy api-dev:3000
    }

    # Dev Web app reverse proxy
    handle {
        reverse_proxy web-dev:80
    }
}
